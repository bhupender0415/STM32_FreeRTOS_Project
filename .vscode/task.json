{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Find ELF",
            "type": "shell",
            "command": "ls -t ${workspaceFolder}/build/*.elf | head -n 1",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "output": "silent",
            "options": {
                "env": {
                    "ELF_PATH": "${output}"
                }
            }
        }
    ]
}
